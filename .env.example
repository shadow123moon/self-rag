# Database
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/paismart_mini?charset=utf8mb4

# Chat model
OPENAI_API_KEY=your_chat_model_api_key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Embedding model
EMBEDDING_URL=https://api.siliconflow.cn/v1
EMBEDDING_KEY=your_embedding_api_key
EMBEDDING_MODEL=BAAI/bge-m3

# Rerank model
RERANK_ENABLED=true
RERANK_URL=https://api.siliconflow.cn/v1/rerank
RERANK_KEY=your_rerank_api_key
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Storage / Chroma
UPLOAD_DIR=./storage/uploads
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=documents
RAG_MAX_DISTANCE=0.95
